[Unit]
Description=Keep the field laptop awake during MeshLink recording
Before=meshlink-survey.service
PartOf=meshlink-survey.service
StopWhenUnneeded=yes

[Service]
Type=exec
RuntimeDirectory=meshlink-survey-awake
ExecStart=/usr/bin/systemd-inhibit --mode=block --what=sleep:idle:handle-lid-switch "--who=MeshLink Field Survey" "--why=The USB survey recorder is running" /usr/bin/sleep infinity
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=meshlink-survey.service
