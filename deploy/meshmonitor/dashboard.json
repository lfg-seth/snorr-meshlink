{
  "uid": "snorr-meshmonitor",
  "title": "SNORR MeshMonitor",
  "tags": [
    "snorr",
    "meshmonitor"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Private radio monitoring \u2014 interpretation",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "[Open MeshMonitor](http://meshmonitor.int.spp.lol:3001) \u00b7 MQTT subscribe only \u00b7 30-day Prometheus metrics\n\nExploratory radio charts. **The MeshLink portal remains authoritative for GPS measurement age, separate gateway receipts and the exact MQTT archive.** Last heard is contact time. Position-observed time is not GPS fix time. Latest reported telemetry can remain cached after a node stops reporting. SNR/RSSI describe a reception, not a measured end-to-end route. Missing readings stay absent. No outbound notifications are configured."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Prometheus scrape available",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"snorr-meshmonitor\"}",
          "legendFormat": "Scrape"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
